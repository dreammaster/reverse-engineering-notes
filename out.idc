	set_cmt	(0X18F9A,	"party hit points. doMovement subtracts a starvation/fatigue amount each step (then prints \"HIT POINTS: \"); creatureAttack subtracts combat damage; <=1 -> \"YOU FALL UNCONSCIOUS.\"; rest / eating restore it. buyFood compares against 0x64 (100 = full).",	1);
