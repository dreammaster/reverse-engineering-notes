	add_func    (0X15D80,0X15D86);
	set_func_flags(0X15D80,0x400);
	set_func_cmt(0X15D80,	"SOUND_METHODS[3]. Sets up bl=255 reps then jumps into soundChirpCore's rising-pitch sweep (longer/higher-pitched variant of soundHit). Not triggered anywhere in SPACE.EXE - likely used by one of the other Ultima I executables sharing this sound code.", 0);
	add_func    (0X15D87,0X15DA7);
	set_func_flags(0X15D87,0x4400);
	set_func_cmt(0X15D87,	"SOUND_METHODS[4], and the shared rising-pitch sweep loop that soundHit/soundChirpLong jump into with their own repeat count (dh climbs by 5 each of bl repetitions, shrinking the per-toggle delay -> pitch rises over the effect). Called directly (bl=8, a short chirp) via SOUND_METHODS[4]; not otherwise observed triggered in SPACE.EXE.", 0);
	set_frame_size(0X15D87, 0, 0, 0);
