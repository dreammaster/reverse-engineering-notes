	add_func    (0X15DAE,0X15DC8);
	set_func_flags(0X15DAE,0x4400);
	set_func_cmt(0X15DAE,	"SOUND_METHODS[6]. Standalone descending-pitch sweep (outer counter bh runs 0xA0..0, inner delay length grows as bh falls). Not triggered anywhere in SPACE.EXE.", 0);
