	add_func    (0X11AF5,0X11B21);
	set_func_flags(0X11AF5,0x400);
	set_func_cmt(0X11AF5,	"Bounds check: true if (x,y) falls inside the viewport (20 < x < 300, 20 < y < 140).", 0);
	set_frame_size(0X11AF5, 0X4, 0, 0);
	define_local_var(0X11AF5, 0X11B21, "[bp+0X2]", "x");
	define_local_var(0X11AF5, 0X11B21, "[bp+0X4]", "y");
	add_func    (0X11B21,0X11BBF);
	set_func_flags(0X11B21,0x400);
	set_func_cmt(0X11B21,	"Picks a random velocity/edge-position for warp star `index`: a random direction/quadrant (word_1D2CA) and magnitude, mirrored so the star starts near an edge of the viewport and moves outward; falls back to a large (5000,5000) offscreen value if the roll would start it already out of view. Stores into stars_x[index]/stars_y[index].", 0);
	set_frame_size(0X11B21, 0XA, 0, 0);
	define_local_var(0X11B21, 0X11BBF, "[bp-0X6]", "xp");
	define_local_var(0X11B21, 0X11BBF, "[bp-0X4]", "yp");
	define_local_var(0X11B21, 0X11BBF, "[bp+0X2]", "index");
	add_func    (0X11BBF,0X11BE9);
	set_func_flags(0X11BBF,0x400);
	set_frame_size(0X11BBF, 0X4, 0, 0);
	add_func    (0X11BE9,0X11C2A);
	set_func_flags(0X11BE9,0x400);
	set_func_cmt(0X11BE9,	"Draws (or erases, if color==0) the rectangular viewport border outline around viewCenterX/viewCenterY. Used both as the cockpit-view frame border and to blank/redraw it during starfield panning, hyperjump warp, and combat.", 0);
	set_frame_size(0X11BE9, 0X6, 0, 0);
	add_func    (0X11C2A,0X11DDA);
	set_func_flags(0X11C2A,0x400);
	set_func_cmt(0X11C2A,	"Per-frame starfield update, called every cockpit-view frame and in a tight loop during hyperjump's accelerate/decelerate phases. Erases/redraws viewportBorder if needed, then for each of the 40 stars (word_1D2CE==2, normal flight: pans all stars by viewPanDeltaX/viewPanDeltaY, clamping viewCenterX/Y and zeroing the pan delta at the sector edges) or otherwise (word_1D2CE==1/3, warp in/out): moves each star outward from center by a per-star velocity (scaled from getRandomNumber via stars_add), erasing the old pixel and drawing the new one (via drawPixel/star_within_view), respawning a star that left the viewport.", 0);
	set_frame_size(0X11C2A, 0X10, 0, 0);
	add_func    (0X11DDA,0X11E1C);
	set_func_flags(0X11DDA,0x400);
	set_func_cmt(0X11DDA,	"Repositions all 40 warp stars to fresh random edge positions/velocities via stars_add, and resets the per-star \"previous position\" cache (word_1D18A/word_1D1DA) used to erase them next frame.", 0);
	set_frame_size(0X11DDA, 0X8, 0, 0);
	add_func    (0X11E1C,0X12003);
	set_func_flags(0X11E1C,0x400);
	set_func_cmt(0X11E1C,	"Moves the player to a new sector when their ship reaches a sector boundary (used by both cockpit-view hyperjump/flight and, indirectly, matches the overhead-view sub_134A8/sub_134D9 clamping). Picks a delta based on which edge the ship exited (SpaceMapShip.x vs sectorChangeX/Y sign), wraps _sector_x/_sector_y into [0,6], finds a free ships[] slot in the new sector (SpaceMapShip._shipType == -1), copies the player's ship record into it, marks the old slot free, repositions the player's ship to a fixed (260,90) start point, and - if the new sector rolled any enemies (_enemyCount != 0) - calls setup_sector_enemies to prime the first encounter.", 0);
	set_frame_size(0X11E1C, 0X20, 0, 0);
	define_local_var(0X11E1C, 0X12003, "[bp-0XC]", "deltaX");
	define_local_var(0X11E1C, 0X12003, "[bp-0XA]", "deltaY");
	define_local_var(0X11E1C, 0X12003, "[bp-0X8]", "shipNum");
	define_local_var(0X11E1C, 0X12003, "[bp-0X6]", "oldSectorX");
	define_local_var(0X11E1C, 0X12003, "[bp-0X4]", "oldSectorY");
	add_func    (0X12003,0X121FC);
	set_func_flags(0X12003,0x5510);
	set_func_cmt(0X12003,	"\"HyperJump\" command - only usable in cockpit view (100 fuel). Plays a \"...\" / \"Lightspeed!\" warp animation: ramps _cockpit_speed up via repeated advanceStarfield/cockpit_per_frame calls, re-seeds the RNG and replays the same star pattern in reverse (word_1D2CE 1 -> 3) to fake an accelerate/decelerate bookend, then cruises (word_1D2CE=2) while ramping speed back down. Finishes by consuming the fuel, re-seeding the RNG for the new sector, and calling change_sector to warp to a random adjacent-ish sector (reusing the sectorChangeX/Y-style random ship-exit-edge logic).", 0);
	set_frame_size(0X12003, 0X12, 0, 0);
	define_local_var(0X12003, 0X121FC, "[bp-0X8]", "speed");
	define_local_var(0X12003, 0X121FC, "[bp-0X4]", "seed");
	add_func    (0X121FC,0X12252);
	set_func_flags(0X121FC,0x5410);
	set_func_cmt(0X121FC,	"\"Space Ace\" rank-achieved screen: clears/redraws the border, prints \"Thou hast achieved the rank of Space Ace!\", waits, and returns to the sector view. Triggered from handleFireCommand once _savegame._enemyVessels reaches 20.", 0);
	set_frame_size(0X121FC, 0, 2, 0);
	add_func    (0X12252,0X123F3);
	set_func_flags(0X12252,0x400);
	set_func_cmt(0X12252,	"Implements the \"Fire!\" command in cockpit view (called from fire() when _cockpitView!=0). Costs 10 fuel (aborts with \"Thou hast not enough fuel!\" if short). Draws a laser-bolt line from the bottom of the viewport up to the current target (targetX/targetY), plays a sound, then hit-tests the shot against the target enemy's current hitbox (the targetApproachStage-indexed bound tables at dseg +0x212/+0x220, mirroring the sprite offset tables at +0x1F6/+0x204 used by blitEnemyShipSpriteXor). On a hit: \"Hit!!!\", +100xp, increments _savegame._enemyVessels (kill count) - reaching 20 triggers spaceAce() (\"Thou hast achieved the rank of Space Ace!\"), beyond 20 prints \"Thou art still a Space ace!\" instead. Decrements this sector's _enemyCount; if more remain, setup_sector_enemies() picks the next target, otherwise targetX/targetY are cleared (no target).", 0);
	set_frame_size(0X12252, 0XE, 0, 0);
	add_func    (0X123F3,0X1254B);
	set_func_flags(0X123F3,0x400);
	set_func_cmt(0X123F3,	"Draws the front-view cockpit console border: 4 filled corner panels plus a row of tick marks along the top/bottom and left/right edges of the viewport window. Called once from setupView when entering the game (independent of _cockpitView; the overhead view simply never shows through it).", 0);
	set_frame_size(0X123F3, 0X8, 0, 0);
	add_func    (0X1254B,0X1258D);
	set_func_flags(0X1254B,0x400);
	set_func_cmt(0X1254B,	"Picks the current encounter target's screen position: while a hyperjump warp is still settling (sectorJustEnteredFlag/word_17F6C != 0) no target is chosen yet (targetX/targetY = 0); otherwise picks a random targetX (40..280) / targetY (40..120) and resets targetApproachStage (word_17F6A) to 0 - a fresh, far-away encounter. Called on arrival in a new sector (change_sector), after a kill (handleFireCommand) if enemies remain, and when a target drifts out of view or fully closes in (cockpit_per_frame).", 0);
	set_frame_size(0X1254B, 0X4, 0, 0);
	add_func    (0X1258D,0X1259E);
	set_func_flags(0X1258D,0x4410);
	set_func_cmt(0X1258D,	"Initializes the 40 warp stars and redraws the viewport border - the cockpit-view half of setupView.", 0);
	set_frame_size(0X1258D, 0, 2, 0);
	add_func    (0X1259E,0X12665);
	set_func_flags(0X1259E,0x400);
	set_func_cmt(0X1259E,	"(Re)draws the current sector view. In cockpit view, delegates to setupStarsView (starfield). In overhead view: draws the station graphic if in sector (3,3), the star graphic if SpaceMapCell.field_2 is set, the planet graphic if field_6 is set, and blitShipSpriteXor's for all 4 ships[] slots that aren't empty (_shipType != -1).", 0);
	set_frame_size(0X1259E, 0XC, 0, 0);
	add_func    (0X12665,0X12731);
	set_func_flags(0X12665,0x400);
	set_func_cmt(0X12665,	"Checks the ship's distance to this sector's hazard/star point (SpaceMapCell.field_2/field_4). If within 25 units on both axes, prints \"Thy ship melts near the star!\" and calls death(). For the station sector (3,3) this point is hardcoded to (140,70) in setup_space_map, so flying too close to the station itself (without reaching the actual docking-bay entrance at (60,75), see checkForLanding) is also fatal.", 0);
	set_frame_size(0X12665, 0X8, 0, 0);
	add_func    (0X12731,0X127EE);
	set_func_flags(0X12731,0x400);
	set_func_cmt(0X12731,	"Only meaningful in the station sector (3,3): if the player's ship (SpaceMapCell.ships[_shipIndex]) is within 25 units of the fixed docking-bay entrance point (60,75), and its _shipType is SHIP_SHUTTLE, copies that ship's current _fuel/_shield into _savegame._shipFuel/_shipShield and calls exit() (\"Thou hast landed safely!\", returning to Sosaria). Any other ship type at that point is destroyed (\"Only space shuttles are heat shielded for landings!\") - matches the game rule that only the shuttle can land, not a fighter.", 0);
	set_frame_size(0X12731, 0XA, 0, 0);
	define_local_var(0X12731, 0X127EE, "[bp-0X4]", "ship");
	add_func    (0X127EE,0X1281F);
	set_func_flags(0X127EE,0x400);
	set_func_cmt(0X127EE,	"Bounds-checks (x in 21..299, y in 19..140 - the overhead sector viewport) then calls xorPutPixel(x,y,color). Used by the ship-sprite outline drawers (drawShuttleSprite/drawSmallFighterSprite/drawLargeFighterSprite) so off-screen pixels are silently skipped.", 0);
	set_frame_size(0X127EE, 0X4, 0, 0);
	add_func    (0X1281F,0X12B7B);
	set_func_flags(0X1281F,0x400);
	set_func_cmt(0X1281F,	"Draws the shuttle icon outline for SHIP_SHUTTLE (facing-indexed via off_12839: 0=left,1=right,2=up,3=down), using plotShipPixelBounded with _borderColor2/_edgeColor. Called from drawShipSprite.", 0);
	set_frame_size(0X1281F, 0X8, 0, 0);
	add_func    (0X12B7B,0X12EC1);
	set_func_flags(0X12B7B,0x400);
	set_func_cmt(0X12B7B,	"Draws the small-fighter icon outline for SHIP_SMALL_FIGHTER (\"Fighter 2\" / heavy shields, see getShipShieldCapacity), facing-indexed via off_12B95. Called from drawShipSprite.", 0);
	set_frame_size(0X12B7B, 0X8, 0, 0);
	add_func    (0X12EC1,0X13109);
	set_func_flags(0X12EC1,0x400);
	set_func_cmt(0X12EC1,	"Draws the large-fighter icon outline for SHIP_LARGE_FIGHTER (\"Fighter 1\" / high fuel, see getShipFuelCapacity), facing-indexed via off_12EDB. Called from drawShipSprite.", 0);
	set_frame_size(0X12EC1, 0X8, 0, 0);
	add_func    (0X13109,0X1319F);
	set_func_flags(0X13109,0x400);
	set_func_cmt(0X13109,	"Dispatches to drawShuttleSprite / drawLargeFighterSprite / drawSmallFighterSprite based on ship->_shipType. arg (draw) selects erase-old-position (0, also decrements _countdown) vs draw-new-position (1) pass; called twice per frame from per_frame_logic while the ship is moving.", 0);
	set_frame_size(0X13109, 0XA, 0, 0);
	define_local_var(0X13109, 0X1319F, "[bp+0X2]", "ship");
	add_func    (0X131D7,0X13330);
	set_func_flags(0X131D7,0x5400);
	set_func_cmt(0X131D7,	"Called each cockpit-view frame from cockpit_per_frame when a target is being engaged. ~2% chance of no shot at all (early-out checks also require targetApproachStage!=0, not mid-hyperjump-settle, and targetX!=0). Otherwise prints \"Alien fires!\", draws a laser-bolt line in from a random screen edge to the target's current sprite position, plays a sound/waits/erases the bolt, and on a further ~25% chance (roll < 0x40) prints \"You've been hit!\" and drains shields - draining them to 0 kills the player (\"Thy shield is drained!\").", 0);
	set_frame_size(0X131D7, 0X10, 0, 0);
	add_func    (0X13330,0X134A8);
	set_func_flags(0X13330,0x400);
	set_func_cmt(0X13330,	"Per-frame update while in cockpit (front) view. Ticks _countdown, calls advanceStarfield. If the current sector has no enemies left, returns. Otherwise: caches the previous target position, shrinks targetX/targetY toward the viewport center by this frame's starfield delta (simulating the target drifting closer as you fly forward); if it has drifted out of the viewport bounds it counts as \"passed\" - erase its sprite and setup_sector_enemies() picks a fresh target. Otherwise, on a timer/random roll gated by _cockpit_speed and approachTimer (word_180B2), increments targetApproachStage (word_17F6A, 0..6 - the enemy sprite \"zooms in\" a stage at a time); past stage 6, setup_sector_enemies() resets the encounter. Finally redraws the enemy sprite at its new stage/position, calls alienFiresBack, and redraws the viewport border if the starfield moved enough this frame.", 0);
	set_frame_size(0X13330, 0XC, 0, 0);
	add_func    (0X134A8,0X134D9);
	set_func_flags(0X134A8,0x400);
	set_func_cmt(0X134A8,	"Adds sectorChangeX to the given X and clamps to [0x14, 0x113] (the sector's playable X range), returning the clamped value.", 0);
	set_frame_size(0X134A8, 0X4, 0, 0);
	add_func    (0X134D9,0X1350A);
	set_func_flags(0X134D9,0x400);
	set_func_cmt(0X134D9,	"Adds sectorChangeY to the given Y and clamps to [0x0A, 0x82] (the sector's playable Y range), returning the clamped value.", 0);
	set_frame_size(0X134D9, 0X4, 0, 0);
	add_func    (0X1350A,0X13567);
	set_func_flags(0X1350A,0x400);
	set_func_cmt(0X1350A,	"Called when the ship's projected move would leave the sector bounds (the \"Crunch!\" case). First re-checks checkStarProximity and checkForLanding (a shuttle reaching the docking-bay entrance point lands safely here instead of crunching); otherwise prints \"Crunch!\", plays a sound, and drains shields by shields/4+5. If shields hit 0, prints \"Thy shield is drained!\" and calls death(); otherwise negates sectorChangeX/sectorChangeY to bounce the ship back off the boundary.", 0);
	set_frame_size(0X1350A, 0X4, 0, 0);
	add_func    (0X13567,0X13741);
	set_func_flags(0X13567,0x400);
	set_func_cmt(0X13567,	"Handles arrival at the space station (sector 3,3): prints \"Docked! Welcome to base!\"; if _readyArmor < 4 (no vacuum/reflect suit equipped) the airlock exposes the player to vacuum and they die; if coins < 500 the 500gp docking fee can't be paid and refueling is refused; otherwise 500gp is charged and the two idle ships' fuel/shield are refreshed via getShipFuelCapacity/getShipShieldCapacity. If more than one real ship is present, prompts \"Choose thy ship: \" (readShipChoiceKey), resolves the 1-4 digit to an edge via findDockedShipAtEdge, and switches _shipIndex to fly that ship (matches the game's Fighter 1 / Fighter 2 / Shuttle ship-swap mechanic - each hangar slot keeps its own persistent fuel/shield). Finishes by refreshing the fuel/shield/coins HUD.", 0);
	set_frame_size(0X13567, 0X14, 0, 0);
	add_func    (0X13741,0X137E0);
	set_func_flags(0X13741,0x400);
	set_func_cmt(0X13741,	"Given a ships[] slot index, checks whether that ship's current x/y/facing exactly match the expected \"parked\" position for one of the 4 station edges (0=left,1=right,2=top,3=bottom - same check as findDockedShipAtEdge, run in the opposite direction). Returns the matching edge index, or -1 if the ship isn't sitting in a valid dock slot. per_frame_logic calls this each frame on the player's own ship to detect \"has just docked\" and trigger dockAtStation.", 0);
	set_frame_size(0X13741, 0XC, 0, 0);
	define_local_var(0X13741, 0X137E0, "[bp-0X6]", "shipNum");
	define_local_var(0X13741, 0X137E0, "[bp-0X4]", "ship");
	define_local_var(0X13741, 0X137E0, "[bp+0X2]", "currShipNum");
	add_func    (0X137E0,0X1386B);
	set_func_flags(0X137E0,0x400);
	set_func_cmt(0X137E0,	"arg_0 = docking-bay edge index (0=left,1=right,2=top,3=bottom - see EDGE_NAMES). Searches the current sector cell's 4 SpaceMapShip slots for the one whose x/y (via check_overlap_x?/check_overlap_y?, which add DELTA_X/DELTA_Y[edge][shipType] to SpaceMapCell.field_6/field_8) matches that edge. Returns the matching ships[] slot index, or -1 (0FFFFh) if no ship is parked there. Used by dockAtStation to resolve the player's \"Choose thy ship\" digit into an actual ship slot.", 0);
	set_frame_size(0X137E0, 0XC, 0, 0);
	add_func    (0X1386B,0X13983);
	set_func_flags(0X1386B,0x400);
	set_frame_size(0X1386B, 0X10, 0, 0);
