	split_sreg_range(0X1E7F0,"fs",BADSEL,3);
	split_sreg_range(0X10000,"gs",BADSEL,3);
	split_sreg_range(0X172D0,"gs",BADSEL,3);
	split_sreg_range(0X1D3F0,"gs",BADSEL,3);
	split_sreg_range(0X1E7F0,"gs",BADSEL,3);
}

