	set_cmt	(0X1D2CE,	"Selects advanceStarfield's behavior. Observed values (all set by hyperjump/pass): 1 = hyperjump warp-in (stars fly outward from center, accelerating); 3 = warp-out/decelerate (same, different seed/replay); 2 = normal cruise (stars pan by viewPanDeltaX/viewPanDeltaY instead of radiating). Not renamed with full confidence in the exact intended semantics of each value - verify against advanceStarfield before relying on this name.",	1);
	create_word	(0X1D2CE);
	set_name	(0X1D2CE,	"starfieldMode");
	set_cmt	(0X1D2D0,	"Caches the player ship's SpaceMapShip._facing from the previous frame (see per_frame_logic); a facing (or position) change vs this cached value is treated as \"the ship moved this frame\", triggering the redraw/collision recheck. NOTE: dockAtStation also writes this location, but stores the newly-selected ship's X position there, not a facing value - re-verify that write if you touch this logic, it looks like it relies on per_frame_logic overwriting it again on the very next frame.",	1);
