	add_func    (0X10EBD,0X10F0E);
	set_func_flags(0X10EBD,0x401);
	set_func_cmt(0X10EBD,	"The \"leave outer space\" routine (not the C runtime exit() - despite the name it returns control to a different program rather than terminating the process). If the player has 0 hits (i.e. just died - see death()) it first zeroes out the current ship's fuel/shield. Then save_file's the whole _savegame struct to \"inuse.u1\", and chain-execs \"out.exe\" (DOS EXEC, argv = {\"out.exe\",\"S\"}) - SPACE.EXE hands control back to OUT.EXE (the overworld executable) this way, confirming the game's multi-EXE architecture (see also aInuse_u1/aOut_exe). If the exec fails, promptDiskSwapRetry and retry forever - this function never returns.", 0);
	set_frame_size(0X10EBD, 0X6, 0, 0);
	add_func    (0X10F0E,0X10F25);
	set_func_flags(0X10F0E,0x4410);
