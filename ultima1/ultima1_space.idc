	set_func_cmt(0X139BE,	"Shows \"Insert Ultima I diskette\" / \"Hit space to continue...\" and waits for a space keypress. Called by loadData/save_file when a file operation fails (the disk-swap loop for a floppy-based install), and by exit() when chain-exec'ing out.exe fails.", 0);
	set_frame_size(0X139BE, 0X4, 0, 0);
