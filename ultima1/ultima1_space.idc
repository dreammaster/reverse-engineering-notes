	id = get_struc_id("SpaceMapShip");
	mid = add_struc_member(id,"x",	0,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"y",	0X2,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"_shipType",	0X4,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"_fuel",	0X6,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"_shield",	0X8,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"_facing",	0XA,	0x18800400,	get_enum("ShipFacing"),	2);
	
	id = get_struc_id("SpaceMapCell");
	mid = add_struc_member(id,"_enemyCount",	0,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"field_2",	0X2,	0x10000400,	-1,	2);
	set_member_cmt(id,	0X2,	"Sector hazard/star X position, paired with field_4. Set by setup_space_sector for ~38% of sectors (random 50..200); hardcoded to 140 for the station sector (3,3) in setup_space_map. Read by checkStarProximity to kill the ship if it strays within 25 units. CAUTION: the same field name is reused by IDA's stroff display in check_overlap_x? when the index register already includes the ships[] sub-offset - there it actually addresses SpaceMapShip.x of the indexed ship, unrelated to this field.",	1);
	mid = add_struc_member(id,"field_4",	0X4,	0x10000400,	-1,	2);
	set_member_cmt(id,	0X4,	"Sector hazard/star Y position, paired with field_2. Set by setup_space_sector (random 50..120); hardcoded to 70 for the station sector (3,3). Read by checkStarProximity. CAUTION: aliased in stroff display with SpaceMapShip._shipType (offset 4 within a ship record) in check_overlap_x?/check_overlap_y? when the index already includes the ships[] sub-offset.",	1);
	mid = add_struc_member(id,"field_6",	0X6,	0x10000400,	-1,	2);
	set_member_cmt(id,	0X6,	"Docking/encounter anchor X: reference point added to DELTA_X[edge][shipType] (see findDockedShipAtEdge/collision_check/check_overlap_x?) to compute where a parked/spawned ship sits. Set by setup_space_sector (random 50..200, kept only if >=40 away from the field_2/field_4 hazard point); hardcoded to 200 for the station sector (3,3). A value of 0 here means \"no ship(s) spawned in this sector\". CAUTION: aliased in stroff display with SpaceMapShip._fuel (offset 6 within a ship record) in displayFuelNumber/check_overlap_x? when the index already includes the ships[] sub-offset.",	1);
	mid = add_struc_member(id,"field_8",	0X8,	0x10000400,	-1,	2);
	set_member_cmt(id,	0X8,	"Docking/encounter anchor Y, paired with field_6 (see DELTA_Y[edge][shipType]). Hardcoded to 100 for the station sector (3,3). CAUTION: aliased in stroff display with SpaceMapShip._shield (offset 8 within a ship record) in displayShieldNumber/check_overlap_y? when the index already includes the ships[] sub-offset.",	1);
	mid = add_struc_member(id,"ships",	0XA,	0x60000400,	get_struc_id("SpaceMapShip"),	48);
	
	id = get_struc_id("SpaceMapY");
	mid = add_struc_member(id,"y",	0,	0x60000400,	get_struc_id("SpaceMapCell"),	406);
	
	id = get_struc_id("SpaceMap");
	mid = add_struc_member(id,"x",	0,	0x60000400,	get_struc_id("SpaceMapY"),	2842);
	
	id = get_struc_id("FightData");
	mid = add_struc_member(id,"field_0",	0,	0x00000400,	-1,	3192);
	
	id = get_struc_id("JumpEntry");
	mid = add_struc_member(id,"_value",	0,	0x10300400,	-1,	2);
	mid = add_struc_member(id,"_offset",	0X2,	0x10500400,	0X10000,	2,	BADADDR,	0,	0x000002);
	return id;
}

