	add_func    (0X168F8,0X169F1);
	set_func_flags(0X168F8,0x4410);
	set_func_cmt(0X168F8,	"Raw video-mode-aware (CGA/Tandy/EGA) XOR pixel plot at (x,y) with the given color/plane byte, writing directly to the B800:/A000: framebuffer. Called (bounds-checked) by plotShipPixelBounded.", 0);
	set_frame_size(0X168F8, 0X4, 2, 0X6);
	add_func    (0X169F1,0X16A18);
	set_func_flags(0X169F1,0x4410);
	set_func_cmt(0X169F1,	"Tandy/PCjr-mode counterpart of initVideoCga.", 0);
	set_frame_size(0X169F1, 0X4, 2, 0);
	add_func    (0X16A18,0X16A3F);
	set_func_flags(0X16A18,0x4410);
	set_func_cmt(0X16A18,	"EGA-mode counterpart of initVideoCga.", 0);
	set_frame_size(0X16A18, 0X4, 2, 0);
	add_func    (0X16A3F,0X16AD8);
	set_func_flags(0X16A3F,0x4410);
	set_func_cmt(0X16A3F,	"Reads the BIOS text-cursor position, converts it to pixel coordinates (textCursorX/textCursorY), draws the blinking cursor (drawTextCursorBlink) via showCursorFlag, then polls for a raw console character (INT 21h AH=6), decoding the two-byte extended/arrow-key sequences into small integer codes. Consuming a key resets the keyboard buffer and re-toggles the cursor.", 0);
	set_frame_size(0X16A3F, 0X4, 2, 0X2);
	add_func    (0X16AD8,0X16B27);
	set_func_flags(0X16AD8,0x4400);
	set_func_cmt(0X16AD8,	"Draws/toggles the blinking text-input cursor block at (textCursorX,textCursorY) when showCursorFlag is set. Called by getKeypress before and after polling for a key, so the cursor blinks while idle and is cleared once a key is consumed.", 0);
	set_frame_size(0X16AD8, 0, 0, 0);
	add_func    (0X16B27,0X16B37);
	set_func_flags(0X16B27,0x4410);
	set_func_cmt(0X16B27,	"Saves si/di/ds/es, calls resetKeyboardBuffer, restores them. Distinct from resetKeyboardBuffer itself - keep both names distinguishable, don't collapse to the same camelCase name.", 0);
	set_frame_size(0X16B27, 0X4, 2, 0);
	add_func    (0X16B37,0X16B57);
	set_func_flags(0X16B37,0x4400);
	set_frame_size(0X16B37, 0, 0, 0);
	add_func    (0X16B57,0X16BCA);
	set_func_flags(0X16B57,0x400);
	set_func_cmt(0X16B57,	"C-runtime fclose(): if the stream has a dirty write buffer (flags bit 2), flushes it via sub_1447E; if it owns a read/allocated buffer (flags bits 2/3, i.e. mask 0Ch) frees it via sub_14879; clears the buffer fields, then closes the underlying OS handle via fcloseHandle. Returns -1 on any flush/close error, else 0.", 0);
	set_frame_size(0X16B57, 0X8, 0, 0);
	add_func    (0X16BCA,0X16C14);
	set_func_flags(0X16BCA,0x400);
	set_func_cmt(0X16BCA,	"C-runtime fopen(filename, mode): linearly scans the static FILE-table (12 slots, stride 0Eh, base 6002h) for a free entry ([slot+0Ah] flags == 0); if none free, sets lastErrno=24 (EMFILE) and returns NULL. Otherwise hands off to openFileStream to actually open it. Called by loadData/save_file.", 0);
	set_frame_size(0X16BCA, 0X6, 0, 0);
	add_func    (0X16C14,0X16D75);
	set_func_flags(0X16C14,0x400);
	set_func_cmt(0X16C14,	"Parses the fopen() mode string ('r'/'w'/'a', optional trailing 'b'/second-char and '+') into DOS open/create flags, closing the slot first if it was already in use. Dispatches to dosOpenOrCreate: 'r' opens for read (fails/returns NULL if the file doesn't exist), 'w' creates/truncates, 'a' opens for append-create. Fills in the FILE slot's fields (buffer state, low-level handle in the low byte) on success.", 0);
	set_frame_size(0X16C14, 0XD, 0, 0);
	add_func    (0X16D75,0X16DE3);
	set_func_flags(0X16D75,0x400);
	set_func_cmt(0X16D75,	"C-runtime fread() core: copies `count` items of `itemSize` bytes from the stream's read buffer into `data`, calling fillReadBuffer whenever the buffer runs dry. Returns the number of complete items read. Called by loadData.", 0);
	set_frame_size(0X16D75, 0XA, 0, 0);
	add_func    (0X16DE3,0X16E4F);
	set_func_flags(0X16DE3,0x400);
	set_func_cmt(0X16DE3,	"C-runtime fwrite() core: copies `count` items of `itemSize` bytes from `data` into the stream's write buffer, flushing a full buffer via sub_1447E as it goes. Returns the number of complete items written. Called by save_file.", 0);
	set_frame_size(0X16DE3, 0XA, 0, 0);
	add_func    (0X16E4F,0X16E97);
	set_func_flags(0X16E4F,0x400);
	set_func_cmt(0X16E4F,	"Resolves the stream's low-level OS handle via sub_14F8E, flushes any pending state via sub_14767, then clears the stream's handle field. Sets lastIoError on failure. Called by fclose.", 0);
	set_frame_size(0X16E4F, 0X8, 0, 0);
	add_func    (0X16E97,0X170C9);
	set_func_flags(0X16E97,0x5400);
	set_func_cmt(0X16E97,	"Low-level DOS file open/create: allocates a free slot in the low-level handle table (up to maxFileHandles, table at +0x1052), dispatches to dosCreateOrTruncateFile / dosCreateNewFile / the existing-file open path / dosSetHandleInfo as appropriate for the requested flags, and records the resulting OS handle in the slot. Called by openFileStream.", 0);
	set_frame_size(0X16E97, 0X11, 0, 0);
	add_func    (0X170EE,0X17288);
	set_func_flags(0X170EE,0x400);
	set_func_cmt(0X170EE,	"Refills a stream's read buffer once it's exhausted: handles text-mode CR/LF and Ctrl-Z(0x1A)-as-EOF translation, calls the raw read syscall wrapper f() to pull more bytes from the OS handle, and sets the stream's EOF/error flag bits ([slot+0Ah]) as appropriate. Called by freadRaw (and recursively by itself for the CR/LF lookahead case).", 0);
	set_frame_size(0X170EE, 0XB, 0, 0);
	add_func    (0X17288,0X1729A);
	set_func_flags(0X17288,0x410);
	set_func_cmt(0X17288,	"DOS IOCTL - Set Device Information (INT 21h AH=44h,AL=01h) on a file handle. One of dosOpenOrCreate's open-mode-setup paths.", 0);
	set_frame_size(0X17288, 0, 2, 0);
	add_func    (0X1729A,0X172AB);
	set_func_flags(0X1729A,0x410);
	set_func_cmt(0X1729A,	"Raw DOS \"Create File With Handle\" (INT 21h AH=3Ch) - creates the file if it doesn't exist, truncates it to zero length if it does. Used for fopen mode 'w'.", 0);
	set_frame_size(0X1729A, 0, 2, 0);
	add_func    (0X172AB,0X172B8);
	set_func_flags(0X172AB,0x410);
	set_func_cmt(0X172AB,	"Raw DOS \"Create New File\" (INT 21h AH=5Bh) - fails if the file already exists. One of dosOpenOrCreate's create paths.", 0);
	set_frame_size(0X172AB, 0, 2, 0);
	add_func    (0X172B8,0X172C9);
	set_func_flags(0X172B8,0x4410);
	SetType(0X172B8, "int __cdecl createFile(const char *fname, int attr);");
	set_func_cmt(0X172B8,	"int __cdecl createFile(const char *fname, int attr) - raw DOS \"Create Unique File\" (INT 21h AH=5Ah, generates a unique filename under a directory path). One of dosOpenOrCreate's create paths; not otherwise tied to the game's own save file (\"inuse.u1\" is created/truncated via dosCreateOrTruncateFile instead).", 0);
	set_frame_size(0X172B8, 0, 2, 0);
	define_local_var(0X172B8, 0X172C9, "[bp+0X4]", "fname");
	define_local_var(0X172B8, 0X172C9, "[bp+0X8]", "attr");
