	set_func_cmt(0X1603E,	"Low-level video-mode-aware (CGA/Tandy/EGA) sprite blitter: XORs a ship glyph (selected by facing, arg_0) onto the framebuffer at (arg_2,arg_4) using the row-height/pointer tables set up from video_type, and returns a collision flag (spriteCollisionFlag) set when the new pixels overlap something already drawn there (e.g. the station graphic or another docked ship). per_frame_logic calls this once to erase the ship at its old position and once to redraw it at the new one each frame.", 0);
	set_frame_size(0X1603E, 0X4, 2, 0X8);
	add_func    (0X16136,0X1614E);
	set_func_flags(0X16136,0x4400);
	set_func_cmt(0X16136,	"CGA-mode helper for blitShipSpriteXor: ANDs the incoming byte against the existing framebuffer byte to detect overlap (setting spriteCollisionFlag), then XORs it in.", 0);
	set_frame_size(0X16136, 0, 0, 0);
	add_func    (0X1614E,0X161F6);
	set_func_flags(0X1614E,0x4410);
	set_func_cmt(0X1614E,	"Cockpit-view counterpart to blitShipSpriteXor: XOR-blits the currently-engaged enemy's sprite (selected by targetApproachStage/word_17F6A, i.e. how \"close\" it has grown) at the given (x,y), video-mode aware (CGA/Tandy/EGA), returning a collision flag in spriteCollisionFlagCockpit (word_185F2). Called from cockpit_per_frame (erase old position, draw new) and handleFireCommand (erase around the laser-bolt draw).", 0);
	set_frame_size(0X1614E, 0X4, 2, 0X6);
	add_func    (0X16237,0X1624C);
	set_func_flags(0X16237,0x400);
	set_frame_size(0X16237, 0X4, 0, 0);
	add_func    (0X16272,0X16275);
	set_func_flags(0X16272,0x4400);
	set_frame_size(0X16272, 0, 0, 0);
	add_func    (0X16275,0X162AF);
	set_func_flags(0X16275,0x5400);
	set_func_cmt(0X16275,	"Non-blocking single keypress read: get_keypress() -> toupper() -> short wait() (1 tick if a key was read, 3 ticks if not). Returns 0 if no key was pressed.", 0);
	set_frame_size(0X16275, 0X6, 0, 0);
	add_func    (0X162AF,0X162D8);
	set_func_flags(0X162AF,0x400);
	set_func_cmt(0X162AF,	"Polls pollKeyUppercase in a loop (up to 1500 iterations) until a key is pressed, returning its (uppercased) value, or 0 on timeout. Used by dockAtStation to read the 1-4 \"Choose thy ship\" digit.", 0);
	set_frame_size(0X162AF, 0X8, 0, 0);
	add_func    (0X162D8,0X16343);
