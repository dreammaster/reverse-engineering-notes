	split_sreg_range(0X17450,"ds",0X1630,3);
	split_sreg_range(0X10000,"fs",BADSEL,3);
	split_sreg_range(0X16300,"fs",BADSEL,3);
	split_sreg_range(0X17450,"fs",BADSEL,3);
	split_sreg_range(0X10000,"gs",BADSEL,3);
	split_sreg_range(0X16300,"gs",BADSEL,3);
	split_sreg_range(0X17450,"gs",BADSEL,3);
}

