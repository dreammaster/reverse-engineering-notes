	add_func    (0X13DD1,0X13E6E);
	set_func_flags(0X13DD1,0x1403);
	set_func_cmt(0X13DD1,	"draw one nbands x ncols grid of 8x8 cells: reads (videoOff, (ncols<<8)|nbands) from dungeonMapArray[slotIdx], loops nbands rows calling drawTileRun(srcBankBase, seg, videoOff + r*0x140, tileIdxListPtr + r*ncols, ncols). The shared wall/surface primitive.", 1);
	add_func    (0X13E6E,0X14166);
	set_func_flags(0X13E6E,0x1403);
	set_func_cmt(0X13E6E,	"bmDUNG top level: draw the first-person corridor view -- clear (rtm_FE2C), loop over the depth bands (ds:1F5Ah) calling the wall-band + sprite drawers, then present. Called each turn from dunMain / processTileFeature. ~0.75 KB.", 1);
	add_func    (0X14166,0X1427C);
	set_func_flags(0X14166,0x1403);
	set_func_cmt(0X14166,	"per depth band, blit the 3 triples of the 10-word wall-band record (DUNDATA payload 0x20 + cursor): ceiling strip, floor strip, front-wall block -- each via blitViewCell.", 1);
	add_func    (0X1427C,0X1430E);
	set_func_flags(0X1427C,0x1403);
	set_func_cmt(0X1427C,	"blocked-view fallback for an OPEN corridor side: draw that side wall from the left/right-side record's p2 (word 4) or p3 (word 5) strip-table pointer, keyed on the blocking wall tile < 0x80.", 1);
