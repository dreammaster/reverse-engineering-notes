static ApplyStrucTInfos_0(void) {
        auto id;
	id = get_struc_id("date");
	SetType(get_member_id(id, 0x0), "int");
	SetType(get_member_id(id, 0x2), "char");
	SetType(get_member_id(id, 0x3), "char");
	id = get_struc_id("time");
	SetType(get_member_id(id, 0x0), "unsigned __int8");
	SetType(get_member_id(id, 0x1), "unsigned __int8");
	SetType(get_member_id(id, 0x2), "unsigned __int8");
	SetType(get_member_id(id, 0x3), "unsigned __int8");
	return id;
}

//------------------------------------------------------------------------
// Information about type information for structure members

static ApplyStrucTInfos() {
	ApplyStrucTInfos_0();
}

static Structures_0(id) {
        auto mid;

	id = add_struc(-1,"date",0);
	id = add_struc(-1,"time",0);
	
	id = get_struc_id("date");
	mid = add_struc_member(id,"da_year",	0,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"da_day",	0X2,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"da_mon",	0X3,	0x00000400,	-1,	1);
	set_struc_align(id,1);
	
	id = get_struc_id("time");
	mid = add_struc_member(id,"ti_min",	0,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"ti_hour",	0X1,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"ti_hund",	0X2,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"ti_sec",	0X3,	0x00000400,	-1,	1);
	return id;
}

