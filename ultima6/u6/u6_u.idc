	mid = add_struc_member(id,"_bh",	0X3,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"_cl",	0X4,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"_ch",	0X5,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"_dl",	0X6,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"_dh",	0X7,	0x00000400,	-1,	1);
	
	id = get_struc_id("REGS");
	mid = add_struc_member(id,"x",	0,	0x60000400,	get_struc_id("WORDREGS"),	16);
	mid = add_struc_member(id,"h",	0,	0x60000400,	get_struc_id("BYTEREGS"),	8);
	set_struc_align(id,1);
	
	id = get_struc_id("SREGS");
