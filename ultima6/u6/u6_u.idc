	mid = add_struc_member(id,"_di",	0XA,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"cflag",	0XC,	0x10000400,	-1,	2);
	mid = add_struc_member(id,"flags",	0XE,	0x10000400,	-1,	2);
	set_struc_align(id,1);
	
	id = get_struc_id("BYTEREGS");
	mid = add_struc_member(id,"_al",	0,	0x00000400,	-1,	1);
	mid = add_struc_member(id,"_ah",	0X1,	0x00000400,	-1,	1);
