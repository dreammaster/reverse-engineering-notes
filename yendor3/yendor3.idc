	set_cmt	(0X2D87C,	"ticks",	0);
	set_cmt	(0X2D885,	"Draws a picture (ax=id, bx=x) guarded by word_328C6 bit 0, then returns the next frame index (ax+1, wrapping to word_332EC once it reaches word_332EC+word_332EE). Called from the still-unnamed combat dispatcher sub_2C0FE.",	0);
	create_insn	(x=0X2D885);
	op_hex		(x,	1);
	set_name	(0X2D885,	"DrawAnimationFrameAndAdvance");
	create_insn	(x=0X2D896);
	op_hex		(x,	1);
	set_cmt	(0X2D8AF,	"Second commit pass after ApplyAttackToTarget already committed: re-filters status flags by immunity (idempotent), recomputes a COMPOUNDED resistance halving (once per matching bit among the same 7 word_33306/[di+0x98] resistance-category bits, vs. ApplyTargetResistancesToAttack's single first-match halving), and subtracts that from [di+0x10] AGAIN (floored at 0) -- genuinely double-applies damage. Why this re-application is intentional (compounding elemental damage for area attacks?) vs. an artifact isn't resolved. Called from ApplyAttackAlongCorridorLine.",	0);
	create_insn	(0X2D8AF);
	set_name	(0X2D8AF,	"ReapplyDamageWithCompoundedResistance");
	create_insn	(x=0X2D8C0);
	op_hex		(x,	1);
	create_insn	(x=0X2D8CE);
	op_hex		(x,	1);
