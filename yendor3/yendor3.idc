	set_cmt	(0X225B3,	"Retries RandomInRange(3) until it lands on an occupied, non-incapacitated (+0x1C bits 0x1C40) party slot, leaving it selected via SelectPartyRecordById. Also computes di=0xBC28+slot*0x18 (a smaller per-slot table, not confirmed) for the caller. Called from sub_22989.",	0);
