	create_insn	(0X11234);
	create_insn	(0X11276);
	set_cmt	(0X11285,	"For each occupied g_monsterSlots entry with HP ([+0x10]) <= 0: flags its g_combatTurnOrder entry 0x4000 (confirms 'defeated'), clears word_32A1E if it was the active target, and calls GrantMonsterRewards + sub_2313D (cleanup, not traced). If none died this pass, advances the turn instead: ensures word_32A1E is set (SelectActiveMonster), calls sub_2333B (not traced), then walks g_combatTurnOrder from word_32BF4 for the next non-defeated entry.",	0);
	create_insn	(0X11285);
