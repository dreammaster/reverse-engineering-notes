	set_name	(0X2A920,	"DrawShadedPixelRun");
	create_insn	(0X2A935);
	create_insn	(0X2A939);
	set_cmt	(0X2A941,	"If word_328C6 bit 0 is set, expands g_blitMaskLen bytes from g_blitMaskPtr into a 15-word scratch buffer: each byte's low nibble becomes (nibble << 4) zero-extended to a word -- classic masked-blit prep. Factored-out copy of the same loop inlined in DrawPicture (loc_29A02) and sub_29B0F.",	0);
	create_insn	(0X2A941);
	set_name	(0X2A941,	"ExpandBlitMaskNibbles");
