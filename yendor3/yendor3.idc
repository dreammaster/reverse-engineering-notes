	set_cmt	(0X2D863,	"One animation frame (same shape as AnimateProjectileStep, but word_328C6 bit 1 and a 5-tick wait): draws via DrawViewportSprite, redraws cursor, restores background via RestoreCorridorBackgroundFromEMS. Called from sub_2C0FE (a large unnamed dispatcher).",	0);
	create_insn	(x=0X2D863);
