	create_insn	(0X224C2);
	set_cmt	(0X22507,	"Picks a random party member, rolls RollTrapAvoidanceMagnitude using their [+0x50] stat against a trap record's threshold/cap ([si+0x64]/[si+0x66]), then -- only if the party's current facing (word_36CF5 tier bits) matches one of 4 direction bits on the trap's [si+0xE] flags -- finishes populating an icon-bar-style output record and sets word_328C8 bit 8. A wall/door-embedded 'side trap' trigger. Called from unnamed sub_2278C.",	0);
	create_insn	(0X22507);
