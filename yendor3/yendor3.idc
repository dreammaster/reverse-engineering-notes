	set_cmt	(0X2D7F7,	"Applies damage (word_2E49A+word_2E49C) to a dungeon-corridor monster (g_levelMonsters, via sub_2D498/sub_2D4B6, not traced), sets wound/display flags, redraws and waits, then resolves death (GrantMonsterRewards + RemoveMonsterFromMap + RedrawDungeonScreen) or survival (RefreshDungeonScreen) based on HP ([+0x10]). Called from sub_2C0FE.",	0);
	create_insn	(0X2D7F7);
	set_name	(0X2D7F7,	"ApplyDamageToMapMonster");
	create_insn	(x=0X2D817);
	op_hex		(x,	1);
