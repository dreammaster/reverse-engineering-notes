	set_cmt	(0X1C6C2,	"Straight-line multi-target attack: calls GetMonsterAtViewportRow for 3 consecutive depth rows (word_3292C incrementing), applying ApplyResolvedDamageWithResistance to whatever monster is found at each. Matches the 'IN A STRAIGHT LINE' targeting text from ShowClueBookSpellDetail's message table. Called from sub_1DA60.",	0);
	create_insn	(0X1C6C2);
	set_name	(0X1C6C2,	"ApplyDamageAlongCorridorLine");
